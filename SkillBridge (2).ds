 application "SkillBridge"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Add_Course
		{
			displayname = "Add Course"
			success message = "New Course Added Successfully!"
			feature property = 32
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Tutoring_Requests
			(
				type = list	
				displayname = "Tutoring Requests"
				values  = Tutoring_Request.ID
    			bidirectional = Course
    			displayformat = [ID]
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Course_Name
			(
    			type = text
				displayname = "Course Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			unique Course_Code
			(
    			type = text
				displayname = "Course Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category
			(
				type = picklist	
				values  = Add_Course_Category.ID
    			displayformat = [Category_Name]
				allow new entries
				[
					displayname = "Add New Category"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Start_Date
			(
    			type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have End_Date
			(
    			type = date
				displayname = "End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Course_Summary
			(
    			type = richtext
				displayname = "Course Summary"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, alignment, link, table, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7},
					font-family : {"Serif", "Arimo", "Ptmono", "Heuristica", "OpenSans", "Tinos", "Lato", "DejaVuSans", "ComicNeue"}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Course_Type
			(
				type = radiobuttons
				displayname = "Course Type"
				values = {"Free","Paid"}
				initial value = "Free"
				layout = 2
	 			row = 1
	 			column = 1   
				width = medium
			)
			Amount
			(
				type = INR
				initial value = 0.00
	 			row = 1
	 			column = 1   
				width = medium
			)
			Participants
			(
				type = radiobuttons
				values = {"Limited","Unlimited"}
				initial value = "Limited"
				layout = 2
	 			row = 1
	 			column = 1   
				width = medium
			)
			Maximum_participants_allowed
			(
				type = number
				displayname = "Maximum participants allowed"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Seats_Remaining
			(
				type = number
				displayname = "Seats Remaining"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Upcoming","Ongoing","Completed"}
				initial value = "Open"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Tutor1
			(
				type = radiobuttons
				displayname = "Tutor"
				values = {"Assign Now","Let tutors select the course"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Select_Tutor
			(
				type = picklist	
				displayname = "Select Tutor"
				values  = Enroll_User[Enroll_as == "Tutor"].ID
    			displayformat = [" " + Name.first_name + "-" + Email]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Students
			(
				type = list	
				values  = Enroll_User[Enroll_as == "Student"].ID
    			displayformat = [Name.first_name + "-" + Email]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			No_of_Students
			(
				type = number
				displayname = "No of Students"
	 			row = 1
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Students.size()
    						visibility = false
    			)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Add_Course_Category
		{
			displayname = "Add Course Category"
			success message = "New Category Added Successfully!"
			feature property = 32
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Category_Name
			(
    			type = text
				displayname = "Category Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Add_Course_Material
		{
			displayname = "Add Course Material"
			success message = "Course Material Added Successfully!"
			feature property = 32
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Course
			(
				type = picklist	
				values  = Add_Course.ID
    			displayformat = [Course_Code + " - " + Course_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Section_No
			(
    			type = text
				displayname = "Section No"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Section_Name
			(
    			type = text
				displayname = "Section Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Topics
			(
				type = grid
				values  = Add_Topic.ID
    			bidirectional = Section1
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
	 			row = 3
	 			column = 0   
				width = medium
			)
			Course_Material_Files
			(
    			type = upload file
				displayname = "Course Material Files"
    			file count = 10
				browse = local_drive
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		print template
			{
				Pdf_material
				{
							content = {"pageNumberOption":null,"orientation":"null","images":[{"fileName":"","imageId":"","imageType":"","fileId":""}],"imageId":"","isFooterEnabled":false,"containerStyle":"","templateStyle":"text-align: left; width: 793.7px; background-image: none","version":"2","layout":"1","mainLayout":[{"elements":[],"id":1}],"resize":"a4","themeFont":"lato","isHeaderEnabled":false}
				}
			}
		}
		form Add_Topic
		{
			displayname = "Add Topic"
			success message = "Topic Added Successfully!"
			feature property = 32
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Course
			(
				type = picklist	
				values  = Add_Course.ID
    			displayformat = [Course_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = picklist	
				displayname = "Section"
				values  = Add_Course_Material[Course.ID == input.Course].ID
    			bidirectional = Topics
    			displayformat = [" - " + Section_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Topic_No
			(
    			type = text
				displayname = "Topic No"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Topic_Name
			(
    			type = text
				displayname = "Topic Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, alignment, link, table, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7},
					font-family : {"Serif", "Arimo", "Ptmono", "Heuristica", "OpenSans", "Tinos", "Lato", "DejaVuSans", "ComicNeue"}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Tutor_Notes
			(
    			type = richtext
				displayname = "Tutor Notes"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, alignment, link, table, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7},
					font-family : {"Serif", "Arimo", "Ptmono", "Heuristica", "OpenSans", "Tinos", "Lato", "DejaVuSans", "ComicNeue"}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Content_File
			(
    			type = upload file
				displayname = "Content File"
				browse = local_drive, google_docs
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form AI_Learning_Assistant
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Question
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			AI_Response
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Course_Payment
		{
			displayname = "Course Payment"
			success message = "Data Added!"
			feature property = 32
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Course
			(
				type = picklist	
				values  = Add_Course.ID
    			displayformat = [Course_Name + " - " + Course_Code]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Student
			(
				type = picklist	
				values  = Enroll_User[Enroll_as == "Student"].ID
    			displayformat = [" " + Name.first_name + " - " + Email]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Amount
			(
				type = INR
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
