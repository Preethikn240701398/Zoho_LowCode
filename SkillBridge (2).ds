				(
	  			workflow = Course_Subscription
				show action in view header = true
				show action in edit record menu = true
				column header = "Subscribe"
				)
				Start_Date as "Start Date"
				Amount
				Course_Name as "Course Name"
				Course_Code as "Course Code"
				Course_Type as "Course Type"
				Select_Tutor as "Select Tutor"
				Category
				Students
				Students.Email
			)
		}
		list Ongoing_Courses_Student
		{
			displayName = "Ongoing Courses"
			show all rows from Add_Course  [Status == "Ongoing" && Students.Email == zoho.adminuserid]  
			(
