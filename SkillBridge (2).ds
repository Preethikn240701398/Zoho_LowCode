			Run_Scripts_while_editing as "Run Scripts - while editing record"
			{
				type =  form
				form = Enroll_User
				on edit
				{
					actions 
					{
					on validate
					(
						if(input.Email != old.Email || input.Enroll_as != old.Enroll_as)
										{
											if(input.Email != old.Email)
											{
												thisapp.permissions.deleteuser(old.Email);
											}
											thisapp.permissions.assignUserInProfile(input.Email,input.Enroll_as);
											if(input.Enroll_as == "Tutor")
											{
												sendmail
												[
													from :zoho.adminuserid
													to :input.Email
													subject :"Tutor Enrollment - Confirmation"
													message :"Greetings,<br><br>Thanks for joining us!<br><br>We believe that you will provide quality education to students without any hassle.<br><br>Click <a href='https://app.zohocreator.in" + zoho.appuri + "'>here</a> to access your portal.<br><br>Feel free to contact us if you have any queries.<br><br>Regards,<br>" + zoho.adminuser
												]
											}
											else if(input.Enroll_as == "Student")
											{
												sendmail
												[
													from :zoho.adminuserid
													to :input.Email
													subject :"Student Enrollment - Confirmation"
													message :"Greetings,<br><br>Thanks for choosing us! We would like to offer you the best courses in a better way every time.<br><br>Click <a href='https://app.zohocreator.in" + zoho.appuri + "'>here</a> to access your learning portal.<br><br>Learn from anywhere, anytime!<br><br>Regards,<br>" + zoho.adminuser
												]
											}
										}
					)
					}
				}
			}
			Run_Scripts_while_deletin as "Run Scripts - while deleting Record"
			{
				type =  form
				form = Enroll_User
				on delete
				{
					actions 
					{
					on validate
					(
						thisapp.permissions.deleteuser(input.Email);
					)
					}
				}
			}
			Run_Scripts_On_Always2 as "Run Scripts - On Always"
			{
				type =  form
				form = Add_Course_Material
				on add or edit
				{
					actions 
					{
					on load
					(
						hide Topics.Course;
					)
					on validate
					(
						//Assign Course to all topics row
										for each  topic in input.Topics
										{
											topic.Course=input.Course;
										}
					)
					}
				}
			}
			Run_scripts_while_adding_3 as "Run scripts- while adding a record"
			{
				type =  form
				form = Course_Payment
				on add
				{
					actions 
					{
					on success
					(
						studentRecord = Enroll_User[Email == zoho.loginuserid];
										courseRecord = Add_Course[ID == input.Course];
										studentsList = courseRecord.Students;
										studentsList.add(studentRecord.ID);
										courseRecord.Students=studentsList;
										openUrl("#Script:page.refresh","same window");
					)
					}
				}
			}
			Run_scripts_while_adding_4 as "Run scripts- while adding a record"
			{
				type =  form
				form = Course_Payment
				on add
				{
					actions 
					{
					on load
					(
						studentRecord = Enroll_User[Email == zoho.loginuserid].ID;
										courseDetail = Add_Course[ID == input.Course].Students;
										isTrue = courseDetail.contains(studentRecord);
										if(isTrue)
										{
											alert "You have already registered for this course";
										}
					)
					}
				}
			}
			Run_scripts_while_adding_5 as "Run scripts- while adding a record"
			{
				type =  form
				form = Course_Subscription
				on add
				{
					actions 
					{
					on load
					(
						studentRecord = Enroll_User[Email == zoho.loginuserid].ID;
										courseDetail = Add_Course[ID == input.Course].Students;
										isTrue = courseDetail.contains(studentRecord);
