	pages
	{
		page Dashboard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='25%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\n\ttitle = 'Course-wise Students'\n\t\n\t\ttitleColor = '#222326'\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Course_wise_Students'\n\t\n\t\tiszreport = 'true'\n\theightType = 'custom'\n\theightValue = '500'\n/>\n</column><column\n   \t\t width='25%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='50px'\n>\n\t<pc \n\t\tbgColor = '#FAFAFA'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tmarginLeft = '20px'\n\tmarginRight = '20px' \n\tcolor = '#2D2D2D'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Active Students'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Active_Students'\n\t\ttarget = 'new-window'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\n\tcolor = '#FFFFFF'\n\tbgColor = '#117ED2'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'education-hat'\n\tsize = '32px'\n\tcornerRadius = '26px'\n\ticonType = 'solid'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '5px'\n\tcolor = '#117ED2'\n\tsize = '33px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\n\n\n\n\t\tcriteria = 'Enroll_as == &quot;Student&quot; &amp;&amp; Status == &quot;Active&quot;'\n\t  value = 'thisapp.Enroll_User.ID.count'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='50px'\n>\n\t<pc \n\t\tbgColor = '#FAFAFA'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tmarginLeft = '20px'\n\tmarginRight = '20px' \n\tcolor = '#2D2D2D'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Total Courses'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Courses'\n\t\ttarget = 'new-window'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\n\tcolor = '#FFFFFF'\n\tbgColor = '#117ED2'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'files-book-08'\n\tsize = '32px'\n\tcornerRadius = '26px'\n\ticonType = 'solid'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '5px'\n\tcolor = '#117ED2'\n\tsize = '33px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\n\n\n\n\t  value = 'thisapp.Add_Course.ID.count'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</column><column\n   \t\t width='25%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='50px'\n>\n\t<pc \n\t\tbgColor = '#FAFAFA'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tmarginLeft = '20px'\n\tmarginRight = '20px' \n\tcolor = '#2D2D2D'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Active Tutors'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Active_Tutors'\n\t\ttarget = 'new-window'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\n\tcolor = '#FFFFFF'\n\tbgColor = '#117ED2'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'users-2-a-edit'\n\tsize = '32px'\n\tcornerRadius = '26px'\n\ticonType = 'solid'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '5px'\n\tcolor = '#117ED2'\n\tsize = '33px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\n\n\n\n\t\tcriteria = 'Enroll_as == &quot;Tutor&quot; &amp;&amp; Status == &quot;Active&quot;'\n\t  value = 'thisapp.Enroll_User.ID.count'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='50px'\n>\n\t<pc \n\t\tbgColor = '#FAFAFA'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tmarginLeft = '20px'\n\tmarginRight = '20px' \n\tcolor = '#2D2D2D'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Total Payments'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Payments'\n\t\ttarget = 'new-window'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\n\tcolor = '#FFFFFF'\n\tbgColor = '#117ED2'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'business-money-bag'\n\tsize = '32px'\n\tcornerRadius = '26px'\n\ticonType = 'solid'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '5px'\n\tcolor = '#117ED2'\n\tsize = '33px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\n\n\n\n\t  value = 'thisapp.Course_Payment.Amount.sum'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</column><column\n   \t\t width='25%'\n   \t>\n\t<report \n\telementName='Report 1'\n\n\t\n\ttitle = 'Course-wise Payments'\n\t\n\t\ttitleColor = '#222326'\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Course_wise_Payments'\n\t\n\t\tiszreport = 'true'\n\theightType = 'custom'\n\theightValue = '500'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='66%'\n   \t>\n\t<report \n\telementName='Report 2'\n\n\t\n\ttitle = 'Monthly Payments'\n\t\n\t\ttitleColor = '#222326'\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Monthly_Payments'\n\t\n\t\tiszreport = 'true'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column><column\n   \t\t width='34%'\n   \t>\n\t<report \n\telementName='Report 3'\n\n\t\n\ttitle = 'Monthly Joinees (Top 5)'\n\t\n\t\ttitleColor = '#222326'\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Monthly_Joinees'\n\t\n\t\tiszreport = 'true'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dspZml id='zml_snippet' elementName='ZML Snippet'\n>\n\t<![CDATA[htmlpage zml_snippet()\ncontent\n&lt;%{\n\t%&gt;\n&lt;panel&gt;\n&lt;%\n\tif(Add_Course.count() == 0)\n\t{\n\t\topenUrl(&quot;#Form:Add_Course&quot;,&quot;same window&quot;);\n\t}\n\t%&gt;\n&lt;/panel&gt;\n&lt;%\n\n}%&gt;]]>\n</dspZml>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page All_Course_Materials_Page
		{
			displayname = "All Course Materials"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Course_Materials'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_EditBulkRec = 'false'\n\t\t\t\t\tzc_BulkDelete = 'false'\n\t\t\t\t\tzc_BulkDuplicate = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}
	chats
	{
		chat Course_Planner_AI_Assistant
		{
			display name = "Course Planner AI Assistant"
			access level = read_write
			instructions
			(
				value = "You are a Course Planner AI Learning Assistant.\nYour primary goal is to help students understand course topics and explain concepts using simple language.\nYou must rely strictly on the course descriptions, topic details, and tutor notes available within the application's data modules.\nDo not invent course information, hallucinate details, or reveal private student data.\nIf information is not found in the application data, state that you cannot find it rather than making it up.\nFocus on educational support and clarity."
			)
			personalization
			(
				welcome message = "Hello! I am your Course Planner AI Learning Assistant. I can help you understand course topics, explain concepts in simple language, and answer questions based on the course descriptions, topic details, and tutor notes available in this application."
			)
			forms
			(
				Add_Topic
				Add_Course_Material
				Add_Course
			)
		}
	}


		 functions
		 {
			 Deluge
			 {
				 void Add_AI_Agent_Microservice()
                 {
                 	// Define agent configuration details
                 	agentName = "AI Learning Assistant";
                 	knowledgeBase = "Course descriptions, topic details, and tutor notes";
                 	restrictions = "Do not invent course information or disclose private student data";
                 	status = "Active";
                 	availability = "Available to students";
                 	// Construct the configuration message
                 	configMessage = "Configuration: Knowledge Base = " + knowledgeBase + "; Restrictions = " + restrictions + "; Status = " + status + "; Availability = " + availability;
                 	// Insert the new agent record into the AI_Learning_Assistant form
                 	// Note: This form currently stores Question/AI_Response pairs. 
                 	// If a dedicated 'Agent Registry' form exists, use that instead.
                 	// For now, we create a configuration record or log entry.
                 	response = insert into AI_Learning_Assistant
                 	[
                 		Question="Agent Registration: " + agentName
                 		AI_Response=configMessage
                 		Added_User=zoho.loginuser
                 	];
                 	// Access the ID directly from the response map without chaining
                 	recordID = response.get("ID");
                 	info "Agent registered successfully with ID: " + recordID;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Run_Scripts_On_Always as "Run Scripts - On Always"
			{
				type =  form
				form = Add_Course
				on add or edit
				{
					actions 
					{
						hide Status,Tutoring_Requests;
					on user input of Start_Date
					(
						//Validating start and end date
										if(input.Start_Date > input.End_Date)
										{
											alert "Start date must be less than 'End Date'!";
										}
					)
					on user input of End_Date
					(
						//Validating start and end date
										if(input.End_Date < input.Start_Date)
										{
											alert "End date must be greater than 'Start Date'!";
										}
					)
					on validate
					(
						//Autofill status value based on given date
										if(input.Start_Date <= zoho.currentdate && input.End_Date > zoho.currentdate)
										{
											input.Status = "Ongoing";
										}
										else if(input.Start_Date > zoho.currentdate)
										{
											input.Status = "Upcoming";
										}
										else if(input.Start_Date < zoho.currentdate && input.End_Date < zoho.currentdate)
										{
											input.Status = "Completed";
										}
										//Validating start and end date
										if(input.Start_Date > input.End_Date)
										{
											alert "Please specify the valid dates!";
											cancel submit;
										}
					)
					}
					actions  (Course_Type == "Free")
					{
						hide Amount;
					on validate
					(
						//Clearing user inputs in case of 'Free' course 
										input.Amount = null;
					)
					}
					actions  (Participants == "Unlimited")
					{
						hide Maximum_participants_allowed;
					on validate
					(
						//Clearing user inputs in case of 'Unlimited' participants 
										input.Maximum_participants_allowed = null;
										input.Seats_Remaining = null;
					)
					}
					actions  (Course_Type == "Paid")
					{
					on validate
					(
						//Mandate amount field in case of paid course
										if(input.Amount <= 0 || Amount == null)
										{
											alert "Please enter valid amount for paid course!";
											cancel submit;
										}
					)
					}
					actions  (Participants == "Limited")
					{
					on validate
					(
						//Mandate maximum participants field in case of limitted participants
										if(input.Maximum_participants_allowed <= 0 || input.Maximum_participants_allowed == null)
										{
											alert "Please enter valid number for 'Maximum participants allowed'!";
											cancel submit;
										}
										else
										{
											//Updating remaining seats for the course
											input.Seats_Remaining = input.Maximum_participants_allowed - input.Students.size();
										}
					)
					}
					actions  (Tutor1 == "Assign Now")
					{
						show Select_Tutor;
					}
				}
			}
			Run_Scripts_while_adding_ as "Run Scripts - while adding a record"
			{
				type =  form
				form = Add_Course
				on add
				{
					actions 
					{
						hide Students;
					on success
					(
						if(Add_Course.count() == 1)
										{
											openUrl("#Form:Add_Course_Material?Course=" + input.ID,"same window");
										}
					)
					}
				}
			}
			Run_Scripts_On_Always1 as "Run Scripts - On Always"
			{
				type =  form
				form = Enroll_User
				on add or edit
				{
					actions 
					{
						hide Status;
					on user input of Date_of_Birth
					(
						if(input.Date_of_Birth != null && input.Date_of_Birth < zoho.currentdate)
										{
											input.Age = yearsBetween(input.Date_of_Birth,zoho.currentdate);
										}
					)
					}
					actions  (Date_of_Birth is not null && Date_of_Birth == zoho.currentdate || Date_of_Birth > zoho.currentdate)
					{
					on user input of Date_of_Birth
					(
						alert "Please enter valid 'Date of Birth'!";
										input.Age = 0;
					)
					on validate
					(
						alert "Please enter valid 'Date of Birth'!";
										cancel submit;
					)
					}
				}
			}
			Run_Scripts_On_Click_of_O as "Run Scripts - On Click of 'Ok' button"
			{
				type =  form
				form = Course_Subscription
				button = Ok
				on click
				{
					actions 
					{
					on click
					(
						courseRecord = Add_Course[ID == input.Course];
										studentId = Enroll_User[Email == zoho.loginuserid].ID;
										if(courseRecord.Course_Type == "Free")
										{
											//Add student to the corresponding course
											studentRecord = Enroll_User[Email == zoho.loginuserid];
											courseRecord = Add_Course[ID == input.Course];
											studentsList = courseRecord.Students;
											studentsList.add(studentRecord.ID);
											courseRecord.Students=studentsList;
											openUrl("#Script:page.refresh","same window");
										}
										else if(courseRecord.Course_Type == "Paid")
										{
											openUrl("#Form:Course_Payment?Course=" + input.Course + "&Student=" + studentId + "&Amount=" + courseRecord.Amount,"same window");
										}
					)
					}
				}
			}
			Run_Scripts_while_adding_1 as "Run Scripts - while adding Record"
			{
				type =  form
				form = Course_Subscription
				on add
				{
					actions 
					{
						hide Course;
					}
				}
			}
			Run_Scripts_On_Click_of_C as "Run Scripts - On Click of 'Cancel' button"
			{
				type =  form
				form = Course_Subscription
				button = Cancel
				on click
				{
					actions 
					{
					on click
					(
						openUrl("#Script:page.refresh","same window");
					)
					}
				}
			}
			Share_and_send_notificati as "Share and send notification"
			{
				type =  form
				form = Enroll_User
				on add
				{
					actions 
					{
					on success
					(
						/* Assign the user to the selected application profile */
										thisapp.permissions.assignUserInProfile(input.Email,input.Enroll_as);
										/* Send a confirmation email based on the selected role */
										if(input.Enroll_as == "Tutor")
										{
											sendmail
											[
												from :zoho.adminuserid
												to :input.Email
												subject :"Tutor Enrollment - Confirmation"
												message :"Greetings,<br><br>" + "Thanks for joining us!<br><br>" + "We believe that you will provide quality education to students without any hassle.<br><br>" + "Click <a href=\"https://app.zohocreator.in" + zoho.appuri + "\" target=\"_blank\">here</a> to access your portal.<br><br>" + "Feel free to contact us if you have any queries.<br><br>" + "Regards,<br>" + zoho.adminuser
											]
										}
										else if(input.Enroll_as == "Student")
										{
											sendmail
											[
												from :zoho.adminuserid
												to :input.Email
												subject :"Student Enrollment - Confirmation"
												message :"Greetings,<br><br>" + "Thanks for choosing us! We would like to offer you the best courses in a better way every time.<br><br>" + "Click <a href=\"https://app.zohocreator.in" + zoho.appuri + "\" target=\"_blank\">here</a> to access your learning portal.<br><br>" + "Learn from anywhere, anytime!<br><br>" + "Regards,<br>" + zoho.adminuser
											]
										}
					)
					}
				}
			}
			Run_Scripts_while_adding_2 as "Run Scripts - while adding Record"
			{
				type =  form
				form = Tutoring_Approval_Confirmation
				on add
				{
					actions 
					{
						hide Tutor_Request;
					}
				}
			}
			Run_Scripts_On_Click_of_Y as "Run Scripts - On Click of 'Yes' button"
			{
				type =  form
				form = Tutoring_Approval_Confirmation
				button = Yes
				on click
				{
					actions 
					{
					on click
					(
						Status = "Approved";
										requestRec = Tutoring_Request[ID == input.Tutor_Request];
										courseRecord = Add_Course[ID == requestRec.Course];
										courseRecord.Select_Tutor=requestRec.Tutor;
										tutorRec = Enroll_User[ID == requestRec.Tutor];
										sendmail
										[
											from :zoho.adminuserid
											to :tutorRec.Email
											subject :"Tutoring Request Approval Notification"
											message :"Hi " + tutorRec.Name + ",<div><br></div><div>Your tutoring request for " + courseRecord.Course_Name + " has been approved.&nbsp;</div><div><br></div><div>Click <a href=\"" + "https://app.zohocreator.in" + zoho.appuri + "#Report:Tutoring_Requests_Tutor\"" + " target=\"_blank\">here</a> to view the details.</div><div><br></div><div>Regards,</div><div>" + zoho.adminuser + "</div>"
										]
										allRequests = Tutoring_Request[Course == requestRec.Course && Status == "Requested" && ID != input.Tutor_Request];
										for each  request in allRequests
										{
											tutorRec = Enroll_User[ID == request.Tutor];
											request.Status="Rejected";
											sendmail
											[
												from :zoho.adminuserid
												to :tutorRec.Email
												subject :"Tutoring Request Rejection Notification"
												message :"Hi " + tutorRec.Name + ",<div><br></div><div>We regret to inform you that your request for tutoring '" + courseRecord.Course_Name + "' has been rejected by admin due to some valid reasons.</div><div><br></div><div>Click <a href='https://app.zohocreator.in" + zoho.appuri + "#Report:Tutoring_Requests_Tutor' target='_blank'>here</a> to view the status.</div><div><br></div><div>Regards,</div><div>" + zoho.adminuser + "</div><div><br></div>"
											]
										}
										openUrl("#Script:page.parent.refresh","same window");
					)
					}
				}
			}
