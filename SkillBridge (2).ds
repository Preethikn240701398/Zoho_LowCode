		summary My_Profile_Student
		{
			displayName = "My Profile"
			show all rows from Enroll_User  [Email == zoho.loginuserid && Enroll_as == "Student"]  
			(
				Name 
				Address 
	 			(
	      			enable = Show_As_Text
	 			)
				Gender
				Status
				Age
				Date_of_Birth as "Date of Birth"
				Employment_Status as "Employment Status"
				Education_Level as "Education Level"
				About_Me as "About Me"
				Skill_Sets as "Skill Sets"
				Email
				Phone_Number as "Phone Number"
				Photo
				User_ID as "User ID"
				Enroll_as as "Enrolled as"
			)
			options
			(
				display rows = 10
				display records per row = 2
			)
		}
		list Open_Courses
		{
			displayName = "Open Courses"
			show all rows from Add_Course  [Start_Date > zoho.currentdate || Start_Date is today && Select_Tutor.Email is null]  
			(
				Seats_Remaining as "Seats Remaining"
				Status
				Course_Summary as "Course Summary"
				custom action "Tutor this course"
				(
	  			workflow = Tutor_this_course
				show action in view header = true
				show action in edit record menu = true
				column header = "Tutor this course"
				condition = ((Tutoring_Requests.Course == input.ID && Tutoring_Requests.Tutor_Email != zoho.loginuserid) || Tutoring_Requests.ID is null)
				)
				Course_Type as "Course Type"
				Amount
				Participants
				Maximum_participants_allowed as "Maximum participants allowed"
				Category
				End_Date as "End Date"
				Start_Date as "Start Date"
				Course_Code as "Course Code"
				Course_Name as "Course Name"
				Select_Tutor as "Select Tutor"
			)
		}
		list Tutoring_Requests_Tutor
		{
			displayName = "Tutoring Requests"
			show all rows from Tutoring_Request  [Tutor.Email == zoho.loginuserid]  
			(
				Tutor
				Course
				Status
			)
			sort by
			(
				Status ascending
			)
			custom actions
			(
				"Cancel"
				(
	  			workflow = Cancel_Tutoring_request
				condition = (Status == "Requested")
				)
			)
			conditional formatting
			(
				"Requested Formatting"
				{
				condition = (Status == "Requested")
				fields = [Status]
				format = "color:#3599db;background-color:#ffffff;"
				}
				"Approved Formatting"
				{
				condition = (Status == "Approved")
				fields = [Status]
				format = "color:#19bc9f;"
				}
				"Rejected Formatting"
				{
				condition = (Status == "Rejected")
				fields = [Status]
				format = "color:#e64d3b;"
				}
			)
		}
