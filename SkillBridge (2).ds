		{
			displayName = "All Topics"
			show all rows from Add_Topic    
			(
				Topic_No as "Topic No"
				Topic_Name as "Topic Name"
				Content_File as "Content File"
				Description
				Tutor_Notes as "Tutor Notes"
				Section1 as "Section"
				Course
			)
		}
		list Course_Page
		{
			displayName = "Course Page"
			show all rows from Add_Course_Material    
			(
				Course
				Topics
				(
					field = Topics.Topic_No + " - " + Topics.Topic_Name
				)
				Section_No as "Section No"
				Section_Name as "Section Name"
			)
			group by
			(
				Course ascending
			)
		}
		list All_Course_Materials
		{
			displayName = "All Course Materials"
			print template = Pdf_material
			show all rows from Add_Course_Material    
			(
				Topics
				(
					view = All_Topics
					field = Topics.Topic_No + "-" + Topics.Topic_Name
				)
				Course
				Section_No as "Section No"
				Section_Name as "Section Name"
				Course_Material_Files as "Course Material Files"
			)
			group by
			(
				Course ascending
			)
		}
		list Available_Courses_Student
		{
			displayName = "Available Courses"
			show all rows from Add_Course  [Seats_Remaining > 0 || Participants == "Unlimited" && Start_Date == zoho.currentdate || Start_Date > zoho.currentdate && Select_Tutor.Email is not null]  
			(
				Participants
				Maximum_participants_allowed as "Maximum participants allowed"
				Seats_Remaining as "Seats Remaining"
				Status
				Course_Summary as "Course Summary"
				End_Date as "End Date"
