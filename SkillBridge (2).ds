		custom All_Users
		{
			displayName = "All Users"
			show all rows from Enroll_User    
			(
				Name 
				Address 
	 			(
	      			enable = Show_As_Text
	 			)
				Status
				Age
				Date_of_Birth as "Date of Birth"
				About_Me as "About Me"
				Employment_Status as "Employment Status"
				Education_Level as "Education Level"
				Skill_Sets as "Skill Sets"
				User_ID as "User ID"
				Gender
				Enroll_as as "Enrolled as"
				Photo
				Email
				Phone_Number as "Phone Number"
			)
			filters
			(
				Enroll_as
			)
			group by
			(
				Status ascending
			)
			custom actions
			(
				"Custom Action"
				(
	  			workflow = Mark_User_as_Inactive
				condition = (Status == "Active")
				)
				"Mark Active"
				(
	  			workflow = Mark_User_as_Active
				show action in view header = true
				condition = (Status == "Inactive")
				)
			)
			conditional formatting
			(
				"Inactive Formatting"
				{
				condition = (Status == "Inactive")
				fields = [Status]
				format = "color:#919191;background-color:#ffffff;"
				}
				"Active Formatting"
				{
				condition = (Status == "Active")
				fields = [Status]
				format = "color:#19bc9f;background-color:#ffffff;"
				}
			)
		}
