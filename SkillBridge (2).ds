			Generate_AI_Response as "Generate_AI_Response"
			{
				type =  form
				form = AI_Learning_Assistant
				on add
				{
					actions 
					{
					on success
					(
						questionText = input.Question;
										responseText = "";
										if(questionText != null && questionText.trim() != "")
										{
											requestBody = Map();
											messagesList = List();
											systemMessage = Map();
											systemMessage.put("role","system");
											systemMessage.put("content","You are SkillBridge, a helpful course learning assistant. Explain topics in simple language and do not invent course information.");
											messagesList.add(systemMessage);
											userMessage = Map();
											userMessage.put("role","user");
											userMessage.put("content",questionText);
											messagesList.add(userMessage);
											requestBody.put("model","gpt-4o-mini");
											requestBody.put("messages",messagesList);
											apiResponse = invokeurl
											[
												url :"https://api.openai.com/v1/chat/completions"
												type :POST
												body:requestBody.toString()
												headers:{"Content-Type":"application/json","Authorization":"Bearer sk-...GX8A"}
											];
											if(apiResponse.get("choices") != null)
											{
												responseText = apiResponse.get("choices").get(0).get("message").get("content");
											}
											else
											{
												responseText = "Unable to generate an answer. Please check the API configuration.";
											}
											input.AI_Response = responseText;
										}
					)
					}
				}
			}
		}

