   						displayname = "Cancel"
					)
				}
			}
		}
		form Course_Subscription
		{
			displayname = "Course Subscription"
			store data in zc = false
			success message = ""
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Course
			(
				type = picklist	
				values  = Add_Course.ID
    			displayformat = [Course_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Confirmation_Message
			(
    			type = plaintext
				value = "Are you sure you want to enroll yourself in this course?"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Ok
				(
   					type = button
   					displayname = "Ok"
				)
				Cancel
				(
   					type = button
   					displayname = "Cancel"
				)
			}
		}
		form Enroll_User
		{
			displayname = "Enroll User"
			success message = "New User Added Successfully!"
			feature property = 32
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			User_ID
			(
    			type = autonumber
				displayname = "User ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Enroll_as
			(
				type = radiobuttons
				displayname = "Enroll as"
				values = {"Student","Tutor"}
				initial value = "Student"
				layout = 2
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Email
			(
    			type = email
	 			row = 1
	 			column = 1   
				width = medium
			)
			Phone_Number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Gender
			(
				type = radiobuttons
				values = {"Male","Female"}
				initial value = "Male"
				layout = 2
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Photo
			(
    			type = image
				source  = public_url,file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_of_Birth
			(
    			type = date
				displayname = "Date of Birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Age
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employment_Status
			(
				type = picklist
				displayname = "Employment Status"
				values = {"Employed Full-Time","Employed Part-Time","Self-employed","Not employed, but looking for work","Not employed and not looking for work","Homemaker","Retired","Student"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Education_Level
			(
				type = picklist
				displayname = "Education Level"
				values = {"Some High School","High School Graduate or Equivalent","Trade or Vocational Degree","Some College","Associate Degree","Bachelors Degree","Professional Degree"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			About_Me
			(
    			type = textarea
				displayname = "About Me"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Skill_Sets
			(
    			type = text
				displayname = "Skill Sets"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Active","Inactive"}
				initial value = "Active"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Tutoring_Approval_Confirmation
		{
			displayname = "Tutoring Approval Confirmation"
			store data in zc = false
			success message = ""
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Confirmation_Text
			(
    			type = plaintext
				value = "Approving this tutor will reject all other tutor requests for this course. Do you wish to continue?&nbsp;"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Tutor_Request
			(
				type = picklist	
				displayname = "Tutor Request"
				values  = Tutoring_Request.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Yes
				(
   					type = submit
   					displayname = "Yes"
				)
				No
				(
   					type = button
   					displayname = "No"
				)
			}
		}
		form Tutoring_Request
		{
			displayname = "Tutoring Request"
			success message = "Tutor Request Added Successfully"
			feature property = 32
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Tutor
			(
				type = picklist	
				values  = Enroll_User[Enroll_as == "Tutor"].ID
    			displayformat = [Name.first_name + " - " + Email]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Tutor_Email
			(
    			type = textarea
				displayname = "Tutor Email"
	 			row = 1
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Tutor.Email
    						visibility = false
    						format = html
    			)
			)
			Course
			(
				type = picklist	
				values  = Add_Course.ID
    			bidirectional = Tutoring_Requests
    			displayformat = [Course_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Requested","Approved","Rejected"}
				initial value = "Requested"
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
